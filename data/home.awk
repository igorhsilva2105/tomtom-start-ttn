# Monta uma pagina da tela inicial (grade 4x2 de icones 80x80 com nome, mais barra inferior).
# Uso: awk -v page=N -v pages=T -v barfile=/mnt/sdcard/data/bar.rows -f home.awk lista_de_entradas
#   lista_de_entradas: uma linha por aplicativo:  rotulo|arquivo_do_icone.rows|script|nome
#   arquivos .rows: 80 linhas de 160 bytes (80 pixels RGB565) terminadas em \n, sem bytes 0 nem 10.
# Saida: 272 linhas de 960 bytes (uma tela completa 480x272, RGB565). Cores sem byte zero.
function trowc(s,fg,bg,r,wpx,   n,k,m,idx,lp){
  n=length(s); if(n>int(wpx/9)) n=int(wpx/9)
  m=""
  for(k=1;k<=n;k++){
    idx=index(CH,substr(s,k,1)); if(idx==0) idx=index(CH,"?")
    m=m substr(FONT,((idx-1)*15+r)*9+1,9)
  }
  gsub(/1/,fg,m); gsub(/0/,bg,m)
  lp=int((wpx-9*n)/2)
  return substr(BGW,1,2*lp) m substr(BGW,1,2*(wpx-9*n-lp))
}
